# ==============================================================================
# NEO-WILDER V4 — Production Environment Configuration Template
# ==============================================================================
# Copy this file to /etc/neo-wilder/neo-wilder.env with permissions 0600:
#   sudo cp deploy/neo-wilder.env.example /etc/neo-wilder/neo-wilder.env
#   sudo chmod 0600 /etc/neo-wilder/neo-wilder.env
#   sudo chown neowilder:neowilder /etc/neo-wilder/neo-wilder.env
#
# STRICT SECURITY WARNING:
# This system is permanently SIGNAL_ONLY.
# NEVER ADD PRIVATE EXCHANGE API KEYS OR SECRET KEYS.
# No order execution, cancellation, or balance querying is permitted.
# ==============================================================================

# Operational Mode: 'SIGNAL' (Live Telegram Alerts) or 'SHADOW' (Silent DB Logging)
NEO_WILDER_MODE=SIGNAL
NEO_WILDER_ENV=production

# Telegram Bot Credentials (Manual Alert Publication & /fill Self-Report)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE

# Binance USD-M Futures Public Endpoints (Data & Signal Research Venue)
BINANCE_WS_URL=wss://fstream.binance.com/stream
BINANCE_REST_URL=https://fapi.binance.com

# CoinDCX Public Endpoints (Manual Execution Validation & Metrics Venue)
COINDCX_PUBLIC_URL=https://public.coindcx.com
COINDCX_API_URL=https://api.coindcx.com

# Local Persistence (SQLite WAL Single-Writer)
DB_PATH=/var/lib/neo-wilder/neo_wilder_journal.db

# Observability & Process Constraints
LOG_LEVEL=INFO
MAX_RSS_MB=300.0
MAX_CLOCK_SKEW_MS=1000.0
WATCHDOG_HEARTBEAT_SEC=15.0
